# AutoForge Engineering Studio — deployment configuration for infra/docker-compose.yml.
# Copy to .env and replace every REQUIRED value. Never commit .env. Generate secrets with:  openssl rand -hex 32

# ----------------------------------------------------------------------------- site
# Public origin users browse to (scheme + host[:port]). Used for links in emails, CORS/WebSocket origin checks.
PUBLIC_BASE_URL=https://localhost
# Host Caddy serves. A public DNS name gets an automatic Let's Encrypt certificate; "localhost" uses a local CA.
SITE_ADDRESS=localhost
HTTP_PORT=80
HTTPS_PORT=443
AF_ENV=production

# ----------------------------------------------------------------------------- data services
POSTGRES_PASSWORD=REQUIRED-change-me
S3_ACCESS_KEY=REQUIRED-change-me
S3_SECRET_KEY=REQUIRED-change-me
S3_BUCKET=autoforge

# ----------------------------------------------------------------------------- email (verification, invitations, resets)
# Production: your SMTP relay with STARTTLS. For local evaluation run with --profile local-mail and use:
#   SMTP_HOST=mail  SMTP_PORT=1025  SMTP_STARTTLS=false   (messages appear at http://127.0.0.1:8025)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AutoForge <no-reply@example.com>
SMTP_STARTTLS=true

# ----------------------------------------------------------------------------- AI assistant (optional)
# "none" uses the built-in rules engine. "anthropic" enables Claude; users must still opt in per request,
# and CAD files are never sent. Problem statements/requirements leave your network only on opt-in.
AI_PROVIDER=none
ANTHROPIC_API_KEY=

# ----------------------------------------------------------------------------- capacity
KERNEL_WORKERS=2
MAX_UPLOAD_MB=100
# Image tag to run (built locally by default).
AUTOFORGE_VERSION=local
